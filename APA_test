## 26. Volcano Plot (Microglia DTU)

```r
library(ggplot2)
library(ggrepel)

mg_res <- read.csv("ALS_vs_Control_dtu_results.csv")

top_genes <- mg_res %>%
  arrange(empirical_FDR) %>%
  head(10)

ggplot(mg_res, aes(x = log2FC, y = -log10(empirical_FDR))) +
  geom_point(alpha = 0.5) +
  geom_text_repel(data = top_genes, aes(label = gene_name)) +
  theme_classic()
```

