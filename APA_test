## 15–20. Metadata Integration

```r
library(SingleCellExperiment)
library(S4Vectors)

sce <- readRDS("pineda_full_run.txs.Rds")

meta <- read.csv("cell-annotations-63samples.csv", stringsAsFactors = FALSE)

meta$cell_id <- paste(meta$sample_id, meta$barcode, sep = "_")

keep <- intersect(colnames(sce), meta$cell_id)
sce <- sce[, keep]

meta_matched <- meta[match(keep, meta$cell_id), ]
stopifnot(all(colnames(sce) == meta_matched$cell_id))

colData(sce) <- cbind(
  colData(sce),
  DataFrame(meta_matched[, setdiff(names(meta_matched), "cell_id")])
)

saveRDS(sce, "pineda_full_run.txs.annotated.rds")
```

